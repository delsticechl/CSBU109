// ========================================
// QUERY 1
// Tech AND views >= 100
// ========================================

db.posts.find({
    category: "Tech",
    views: { $gte: 100 }
})


// ========================================
// QUERY 2
// Posts tagged with nodejs
// ========================================

db.posts.find({
    tags: "nodejs"
})


// ========================================
// UPDATE
// Add comment + increase views by 1
// ========================================

db.posts.updateOne(
    { title: "Introduction to Node.js" },
    {
        $push: {
            comments: {
                user: "David",
                content: "Great introduction to Node.js!",
                created_at: new Date()
            }
        },
        $inc: {
            views: 1
        }
    }
)


// ========================================
// AGGREGATION
// Total views and total posts by category
// ========================================

db.posts.aggregate([
    {
        $group: {
            _id: "$category",
            totalViews: { $sum: "$views" },
            totalPosts: { $sum: 1 }
        }
    }
])
