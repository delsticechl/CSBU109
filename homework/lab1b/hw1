
const mysql = require("mysql2/promise");

async function createOrder() {
    const conn = await mysql.createConnection({
        host: "localhost",
        user: "root",
        password: "",
        database: "store_transaction_db"
    });

    try {
        // Begin SQL transaction
        await conn.beginTransaction();

        // Example order: Customer 3 buys 2 keyboards
        const customerId = 3;
        const productId = 1;
        const quantity = 2;

        // STEP 1: Check customer balance and product stock
        const [customers] = await conn.execute(
            "SELECT balance FROM customers WHERE id = ? FOR UPDATE",
            [customerId]
        );

        const [products] = await conn.execute(
            "SELECT price, stock FROM products WHERE id = ? FOR UPDATE",
            [productId]
        );

        if (customers.length === 0) {
            throw new Error("Customer not found");
        }

        if (products.length === 0) {
            throw new Error("Product not found");
        }

        const balance = Number(customers[0].balance);
        const price = Number(products[0].price);
        const stock = products[0].stock;
        const total = price * quantity;

        console.log("Customer balance:", balance);
        console.log("Product stock:", stock);
        console.log("Order total:", total);

        if (balance < total) {
            throw new Error("Insufficient balance");
        }

        if (stock < quantity) {
            throw new Error("Out of stock");
        }

        // STEP 2: Deduct money from customer's balance
        await conn.execute(
            "UPDATE customers SET balance = balance - ? WHERE id = ?",
            [total, customerId]
        );

        // STEP 3: Deduct quantity from product stock
        await conn.execute(
            "UPDATE products SET stock = stock - ? WHERE id = ?",
            [quantity, productId]
        );

        // STEP 4: Insert a new order
        const [orderResult] = await conn.execute(
            `INSERT INTO orders
                (customer_id, total_amount, created_at)
             VALUES (?, ?, NOW())`,
            [customerId, total]
        );

        const orderId = orderResult.insertId;

        // STEP 5: Insert the corresponding order item
        await conn.execute(
            `INSERT INTO order_items
                (order_id, product_id, quantity, price)
             VALUES (?, ?, ?, ?)`,
            [orderId, productId, quantity, price]
        );

        // All steps succeeded: save all changes
        await conn.commit();

        console.log("Transaction successful!");
        console.log("Order ID:", orderId);

    } catch (error) {
        // Any error: undo all changes in this transaction
        await conn.rollback();

        console.log("Transaction failed!");
        console.log("Rollback completed.");
        console.log("Reason:", error.message);

    } finally {
        await conn.end();
    }
}

createOrder();
